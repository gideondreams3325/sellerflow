{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private user profile and KYC verification record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "seller", "admin"] },
        "verified": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["none", "pending", "approved", "rejected"] },
        "ghanaCardNumber": { "type": "string" },
        "ghanaCardFrontUrl": { "type": "string" },
        "ghanaCardBackUrl": { "type": "string" },
        "termsAccepted": { "type": "boolean" },
        "termsVersion": { "type": "string" },
        "termsAcceptedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public storefront seller identity and social counters",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "verified": { "type": "boolean" },
        "bio": { "type": "string" },
        "followers": { "type": "array" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "username"]
    },
    "Post": {
      "title": "Post",
      "description": "Social commerce reel, video, or photo post",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaPath": { "type": "string" },
        "mediaType": { "type": "string" },
        "likes": { "type": "array" },
        "saves": { "type": "array" },
        "comments": { "type": "array" },
        "status": { "type": "string", "enum": ["published", "hidden", "pending", "approved", "rejected"] },
        "reviewStatus": { "type": "string", "enum": ["safe", "under_review", "violation", "reviewed"] },
        "violationDetected": { "type": "boolean" },
        "violationRule": { "type": "string" },
        "violationReason": { "type": "string" },
        "violationConfidence": { "type": "number" },
        "needsAdminReview": { "type": "boolean" },
        "soundId": { "type": "string" },
        "soundName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Marketplace listing for goods and inventory",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "stock": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "title", "price"]
    },
    "Store": {
      "title": "Store",
      "description": "Seller customized store presence and business details",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "storeName": { "type": "string" },
        "tagline": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "location": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "storeName"]
    },
    "Order": {
      "title": "Order",
      "description": "Commerce order transaction between buyer and seller",
      "type": "object",
      "properties": {
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
        "phone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerIds": { "type": "array" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerId", "sellerId", "total", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and store rating after order fulfillment",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "reviewerId": { "type": "string" },
        "reviewerName": { "type": "string" },
        "rating": { "type": "number" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "reviewerId", "rating"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app alerts, order updates, broadcasts, and AI safety warnings",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "fromAdmin": { "type": "boolean" },
        "postId": { "type": "string" },
        "detectedRule": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "title", "message"]
    },
    "ScamReport": {
      "title": "ScamReport",
      "description": "Community and AI safety violation reports for admin oversight",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "targetType": { "type": "string" },
        "reason": { "type": "string" },
        "detectedRule": { "type": "string" },
        "confidence": { "type": "number" },
        "reporterId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "reason"]
    },
    "FraudReport": {
      "title": "FraudReport",
      "description": "Anti-fraud and security reports logged against suspicious sellers or products",
      "type": "object",
      "properties": {
        "reportType": { "type": "string" },
        "reportedId": { "type": "string" },
        "reportedName": { "type": "string" },
        "description": { "type": "string" },
        "evidenceUrl": { "type": "string" },
        "reporterUid": { "type": "string" },
        "reporterEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "investigating", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportType", "description", "reporterUid"]
    },
    "AdminReview": {
      "title": "AdminReview",
      "description": "AI safety audit record generated when a policy violation occurs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "postId": { "type": "string" },
        "detectedRule": { "type": "string" },
        "reason": { "type": "string" },
        "confidence": { "type": "number" },
        "status": { "type": "string" },
        "postText": { "type": "string" },
        "mediaType": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "postId", "detectedRule", "reason"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message thread between buyers and sellers",
      "type": "object",
      "properties": {
        "participants": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual chat message within a conversation",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text"]
    },
    "IdentityVerification": {
      "title": "IdentityVerification",
      "description": "Private Ghana Card and live selfie liveness identity verification audit record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "ghanaCardPin": { "type": "string" },
        "ghanaCardMasked": { "type": "string" },
        "ghanaCardHash": { "type": "string" },
        "ghanaCardFrontPath": { "type": "string" },
        "ghanaCardBackPath": { "type": "string" },
        "selfieStoragePath": { "type": "string" },
        "livenessStatus": { "type": "string", "enum": ["COMPLETED", "FAILED", "PENDING"] },
        "livenessCompletedAt": { "type": "string", "format": "date-time" },
        "livenessMovements": { "type": "array" },
        "verificationStatus": { "type": "string", "enum": ["VERIFIED", "REVIEW", "REJECTED", "PENDING"] },
        "verificationMethod": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string" },
        "verificationRecordId": { "type": "string" },
        "auditMetadata": { "type": "object" }
      },
      "required": ["uid", "verificationStatus"]
    },
    "BuyerKycRecord": {
      "title": "BuyerKycRecord",
      "description": "Security team vault record for Ghana Card and identity compliance",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "ghanaCardNumber": { "type": "string" },
        "ghanaCardMasked": { "type": "string" },
        "ghanaCardFrontPath": { "type": "string" },
        "ghanaCardBackPath": { "type": "string" },
        "selfiePath": { "type": "string" },
        "verificationStatus": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "Job": {
      "title": "Job",
      "description": "Verified Ghanaian employment listing with security screening",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "title": { "type": "string" },
        "companyName": { "type": "string" },
        "location": { "type": "string" },
        "locationType": { "type": "string", "enum": ["on_site", "hybrid", "remote"] },
        "region": { "type": "string" },
        "category": { "type": "string" },
        "employmentType": { "type": "string", "enum": ["full_time", "part_time", "contract", "internship", "temporary", "remote"] },
        "salaryMin": { "type": "number" },
        "salaryMax": { "type": "number" },
        "salaryCurrency": { "type": "string" },
        "salaryPeriod": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "string" },
        "responsibilities": { "type": "string" },
        "benefits": { "type": "string" },
        "howToApplyType": { "type": "string", "enum": ["in_app", "external_url", "email"] },
        "applicationUrl": { "type": "string" },
        "applicationEmail": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_review", "approved", "rejected", "paused", "expired", "removed", "draft"] },
        "reviewStatus": { "type": "string", "enum": ["pending_review", "approved", "rejected", "flagged"] },
        "verifiedCreator": { "type": "boolean" },
        "scamWarningAcknowledged": { "type": "boolean" },
        "termsVersion": { "type": "string" },
        "viewsCount": { "type": "number" },
        "savesCount": { "type": "number" },
        "applicationsCount": { "type": "number" },
        "isPromoted": { "type": "boolean" },
        "promotionStatus": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "moderationNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string" }
      },
      "required": ["creatorId", "title", "companyName", "status"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "Confidential candidate application submitted for a verified job listing",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "companyName": { "type": "string" },
        "employerId": { "type": "string" },
        "applicantId": { "type": "string" },
        "applicantName": { "type": "string" },
        "applicantEmail": { "type": "string" },
        "applicantPhone": { "type": "string" },
        "coverLetter": { "type": "string" },
        "cvStoragePath": { "type": "string" },
        "cvFileName": { "type": "string" },
        "cvFileType": { "type": "string" },
        "cvFileSize": { "type": "number" },
        "status": { "type": "string", "enum": ["pending_security_check", "submitted", "under_review", "shortlisted", "interview_scheduled", "accepted", "rejected", "withdrawn", "flagged", "blocked"] },
        "flagReason": { "type": "string" },
        "scamWarningAcknowledged": { "type": "boolean" },
        "termsVersion": { "type": "string" },
        "employerNotes": { "type": "string" },
        "appliedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "applicantId", "applicantName", "status"]
    },
    "Event": {
      "title": "Event",
      "description": "Verified Ghanaian event and workshop gathering with security audit",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "title": { "type": "string" },
        "organizerName": { "type": "string" },
        "category": { "type": "string" },
        "eventType": { "type": "string", "enum": ["in_person", "online", "hybrid"] },
        "venue": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "onlineMeetingUrl": { "type": "string" },
        "startDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endDate": { "type": "string" },
        "endTime": { "type": "string" },
        "timezone": { "type": "string" },
        "description": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "bannerPath": { "type": "string" },
        "ticketType": { "type": "string", "enum": ["free", "paid", "rsvp"] },
        "ticketPrice": { "type": "number" },
        "capacity": { "type": "number" },
        "registeredCount": { "type": "number" },
        "registrationDeadline": { "type": "string" },
        "externalTicketUrl": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_review", "approved", "rejected", "paused", "cancelled", "removed", "expired", "draft"] },
        "reviewStatus": { "type": "string", "enum": ["pending_review", "approved", "rejected", "flagged"] },
        "verifiedOrganizer": { "type": "boolean" },
        "termsVersion": { "type": "string" },
        "viewsCount": { "type": "number" },
        "savesCount": { "type": "number" },
        "isPromoted": { "type": "boolean" },
        "rejectionReason": { "type": "string" },
        "moderationNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string" }
      },
      "required": ["creatorId", "title", "organizerName", "status"]
    },
    "EventRegistration": {
      "title": "EventRegistration",
      "description": "Private attendee event RSVP and registration record",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "creatorId": { "type": "string" },
        "attendeeId": { "type": "string" },
        "attendeeName": { "type": "string" },
        "attendeeEmail": { "type": "string" },
        "attendeePhone": { "type": "string" },
        "ticketCount": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["registered", "cancelled", "checked_in"] },
        "registeredAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "attendeeId", "attendeeName", "status"]
    },
    "TermsAcceptance": {
      "title": "TermsAcceptance",
      "description": "Statutory audit record of user acceptance of versioned terms and privacy notices",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "termsVersion": { "type": "string" },
        "privacyVersion": { "type": "string" },
        "identityVerificationVersion": { "type": "string" },
        "featuresAccepted": { "type": "array" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "userAgent": { "type": "string" }
      },
      "required": ["userId", "termsVersion", "acceptedAt"]
    },
    "SecurityReview": {
      "title": "SecurityReview",
      "description": "Immutable security team review and action audit log",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["job", "event", "application", "post", "product", "user"] },
        "reviewerUid": { "type": "string" },
        "action": { "type": "string", "enum": ["approve", "reject", "request_info", "pause", "remove", "takedown", "escalate"] },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "targetType", "reviewerUid", "action"]
    }
  },
  "firestore": {
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Verified jobs and career listings in Ghana"
    },
    "/jobApplications/{applicationId}": {
      "schema": { "$ref": "#/entities/JobApplication" },
      "description": "Confidential candidate job applications"
    },
    "/jobSaves/{userId}/items/{jobId}": {
      "schema": "string",
      "description": "User bookmarked job listings"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Verified events, expos, and community gatherings in Ghana"
    },
    "/eventRegistrations/{regId}": {
      "schema": { "$ref": "#/entities/EventRegistration" },
      "description": "Private event registrations and RSVPs"
    },
    "/eventSaves/{userId}/items/{eventId}": {
      "schema": "string",
      "description": "User bookmarked events"
    },
    "/termsAcceptances/{userId}": {
      "schema": { "$ref": "#/entities/TermsAcceptance" },
      "description": "Explicit user terms of service and privacy acceptance audit records"
    },
    "/securityReviews/{reviewId}": {
      "schema": { "$ref": "#/entities/SecurityReview" },
      "description": "Authoritative security team moderation audit trail"
    },
    "/identityVerifications/{recordId}": {
      "schema": { "$ref": "#/entities/IdentityVerification" },
      "description": "Private Ghana Card and live selfie liveness verification records"
    },
    "/buyerKycRecords/{recordId}": {
      "schema": { "$ref": "#/entities/BuyerKycRecord" },
      "description": "Security Team compliance archive of Ghana Card documents"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user and seller accounts with KYC identity data"
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public profile listings for sellers and buyers"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "For You feed posts, media reels, and status updates"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Marketplace products and merchandise listings"
    },
    "/stores/{sellerId}": {
      "schema": { "$ref": "#/entities/Store" },
      "description": "Storefront configuration and public vendor information"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Purchases and order management records"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Ratings and feedback for sellers"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications, order alerts, and policy warnings"
    },
    "/scamReports/{reportId}": {
      "schema": { "$ref": "#/entities/ScamReport" },
      "description": "Scam, abuse, and safety reports for administrative triage"
    },
    "/fraudReports/{reportId}": {
      "schema": { "$ref": "#/entities/FraudReport" },
      "description": "Anti-fraud and security reports logged by users against suspicious accounts or listings"
    },
    "/adminReviews/{reviewId}": {
      "schema": { "$ref": "#/entities/AdminReview" },
      "description": "AI safety moderation audit records and detection metrics"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Direct message chat threads"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Chat messages within a conversation"
    },
    "/savedSounds/{userId}/items/{soundId}": {
      "schema": "string",
      "description": "User bookmarked audio sounds"
    },
    "/sounds/{soundId}": {
      "schema": "string",
      "description": "Platform reusable audio catalog"
    },
    "/profileVisits/{visitId}": {
      "schema": "string",
      "description": "Store profile analytics and visit counters"
    },
    "/settings/{settingId}": {
      "schema": "string",
      "description": "System terms of service and global configuration"
    }
  }
}
