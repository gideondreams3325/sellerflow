rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'gideondreams3325@gmail.com' ||
          request.auth.token.email.matches('(?i)^gideondreams3325@gmail\\.com$')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') in ['gideondreams3325@gmail.com'] && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
          )
        )) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('email', '') in ['gideondreams3325@gmail.com']
        ))
      );
    }

    function isAllowedSellerflowUsername() {
      return (
        request.resource.data.get('usernameLower', '') != 'sellerflow' &&
        !request.resource.data.get('username', '').matches('(?i)^sellerflow$')
      ) || (request.auth.token.email != null && (
        request.auth.token.email == 'gideondreams3325@gmail.com' ||
        request.auth.token.email.matches('(?i)^gideondreams3325@gmail\\.com$')
      ));
    }

    // Phone and Email Verification Temporary Codes (Private User Access Only)
    match /phoneVerifications/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /emailVerifications/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Public registries for email and username availability checks
    match /registeredEmails/{emailDoc} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    match /registeredUsernames/{usernameDoc} {
      allow read: if true;
      allow create, update: if isSignedIn() && (
        usernameDoc != 'sellerflow' || (request.auth.token.email != null && (
          request.auth.token.email == 'gideondreams3325@gmail.com' ||
          request.auth.token.email.matches('(?i)^gideondreams3325@gmail\\.com$')
        ))
      );
      allow delete: if isSignedIn();
    }

    // 1b. Dedicated Buyer KYC & Ghana Card Vault (Security Team-only storage for future reference)
    // - Only security administrators can read the stored Ghana Card archive
    // - Authenticated users can write their own identity submission
    // - Sellers and other regular users have ZERO access to buyer identity records
    match /buyerKycRecords/{recordId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == recordId);
      allow delete: if isAdmin();
    }

    // 1c. Private Identity Verifications & Live Selfie Liveness Records
    // - Encrypted storage for Ghana Card metadata, front/back paths, live selfie path, and liveness audit logs
    // - Only the verified account owner and Security Team admins can access
    match /identityVerifications/{recordId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == recordId);
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == recordId);
      allow delete: if isAdmin();
    }

    // 1. Private User Profiles & KYC Identity Data
    // - Only the account owner and admins can read private KYC documents (Ghana Card, etc.)
    // - Regular users CANNOT self-assign role: 'admin' or verificationStatus: 'approved'
    // - Only admins can verify or approve sellers
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && isAllowedSellerflowUsername() && (
        isAdmin() || (
          request.resource.data.get('role', 'user') != 'admin' &&
          request.resource.data.get('verified', false) == false &&
          request.resource.data.get('verificationStatus', 'none') in ['none', 'pending']
        )
      );
      allow update: if (isOwner(userId) || isAdmin()) && isAllowedSellerflowUsername() && (
        isAdmin() || (
          // Non-admins cannot promote themselves to admin
          request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
          // Non-admins cannot self-verify
          request.resource.data.get('verified', false) == resource.data.get('verified', false) &&
          // Non-admins cannot approve their own verification
          request.resource.data.get('verificationStatus', 'none') in [resource.data.get('verificationStatus', 'none'), 'pending'] &&
          // 360-day username change policy
          (
            request.resource.data.get('usernameLower', resource.data.get('usernameLower', '')) == resource.data.get('usernameLower', '') ||
            resource.data.get('usernameLastChanged', null) == null ||
            request.time > resource.data.usernameLastChanged + duration.value(360, 'd')
          )
        )
      );
      allow delete: if isAdmin();
    }

    // 2. Public Storefront Profiles & Social Counters
    // - Anyone can view public profiles
    // - Profile owners can edit their own bio, avatar, name, and presence
    // - Non-owners can ONLY update followers array/counter
    // - PublicProfiles CANNOT be used to grant admin status or self-assign verification badges
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if (isOwner(userId) || isAdmin()) && isAllowedSellerflowUsername() && (
        isAdmin() || request.resource.data.get('verified', false) == false
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Profile owner updating their details without tampering with verified badge
        (
          isOwner(userId) &&
          isAllowedSellerflowUsername() &&
          request.resource.data.get('verified', false) == resource.data.get('verified', false)
        ) ||
        // Other users interacting purely via follow/unfollow
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'followersCount'])
        )
      );
      allow delete: if isAdmin();
    }

    // 3. For You Feed Posts & Video Reels
    // - Anyone can view published posts
    // - Normal clients can ONLY create posts in initial hidden/under_review state
    // - Normal clients CANNOT transition posts to published or safe (server-only approval via Admin SDK)
    // - Normal clients CANNOT modify moderation fields or reinstate posts in violation status
    // - Other users can ONLY interact (like, comment, save, view, share, repost)
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.sellerId == request.auth.uid || isAdmin()
      ) && (
        isAdmin() || (
          // Normal users can ONLY create initial post in hidden/under_review state
          request.resource.data.get('status', 'hidden') == 'hidden' &&
          request.resource.data.get('reviewStatus', 'under_review') == 'under_review' &&
          request.resource.data.get('safeContent', false) == false &&
          !('moderatedBy' in request.resource.data) &&
          !('moderationToken' in request.resource.data) &&
          !('violationDetected' in request.resource.data) &&
          !('violationRule' in request.resource.data) &&
          !('violationReason' in request.resource.data) &&
          !('moderatedAt' in request.resource.data) &&
          !('hiddenAt' in request.resource.data) &&
          !('copyrightDetected' in request.resource.data) &&
          !('audioMutedByCopyright' in request.resource.data) &&
          !('copyrightMatch' in request.resource.data)
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Post author normal content edits: cannot self-approve or alter moderation state
        (
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId &&
          // Cannot modify posts in violation status
          resource.data.get('reviewStatus', '') != 'violation' &&
          request.resource.data.get('reviewStatus', '') != 'violation' &&
          // Normal users CANNOT change status to published or reviewStatus to safe
          request.resource.data.get('status', '') == resource.data.get('status', '') &&
          request.resource.data.get('reviewStatus', '') == resource.data.get('reviewStatus', '') &&
          request.resource.data.get('safeContent', false) == resource.data.get('safeContent', false) &&
          // Normal users cannot tamper with moderation flags or authoritatively publish
          request.resource.data.get('moderatedBy', '') == resource.data.get('moderatedBy', '') &&
          request.resource.data.get('moderationToken', '') == resource.data.get('moderationToken', '') &&
          request.resource.data.get('violationDetected', false) == resource.data.get('violationDetected', false) &&
          request.resource.data.get('violationRule', '') == resource.data.get('violationRule', '') &&
          request.resource.data.get('violationReason', '') == resource.data.get('violationReason', '') &&
          request.resource.data.get('moderatedAt', null) == resource.data.get('moderatedAt', null) &&
          request.resource.data.get('hiddenAt', null) == resource.data.get('hiddenAt', null) &&
          request.resource.data.get('copyrightDetected', false) == resource.data.get('copyrightDetected', false) &&
          request.resource.data.get('audioMutedByCopyright', false) == resource.data.get('audioMutedByCopyright', false) &&
          request.resource.data.get('copyrightMatch', null) == resource.data.get('copyrightMatch', null)
        ) ||
        // Community interaction: other users can ONLY modify social interaction counters/arrays
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likes', 'comments', 'saves', 'views', 'shares', 'reposts'
          ]) &&
          request.resource.data.sellerId == resource.data.sellerId
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // Copyright disputes
    match /copyrightDisputes/{disputeId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 4. Marketplace Products & Catalog
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.sellerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // 5. Vendor Storefronts
    match /stores/{sellerId} {
      allow read: if true;
      allow create, update: if isOwner(sellerId) || isAdmin();
      allow delete: if isOwner(sellerId) || isAdmin();
    }

    // 6. Orders & Checkout Transactions
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        request.auth.uid in resource.data.get('sellerIds', []) ||
        (resource.data.sellerIds is list && request.auth.uid in resource.data.sellerIds) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.buyerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Buyer can cancel or update notes
        (
          resource.data.buyerId == request.auth.uid &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.total == resource.data.total
        ) ||
        // Seller can update order status
        (
          (resource.data.sellerId == request.auth.uid || (resource.data.sellerIds is list && request.auth.uid in resource.data.sellerIds)) &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.total == resource.data.total
        )
      );
      allow delete: if isAdmin();
    }

    // 7. Store Reviews & Verified Ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.reviewerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.reviewerId == request.auth.uid &&
          request.resource.data.reviewerId == resource.data.reviewerId &&
          request.resource.data.sellerId == resource.data.sellerId
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.reviewerId == request.auth.uid || isAdmin()
      );
    }

    // 8. In-App Notifications, Order Alerts & Policy Warnings
    // - Users CANNOT create fake admin broadcasts or fake policy warnings targeting other users
    // - Only admins can issue official admin warnings and broadcasts
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientId == 'all' ||
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'all' ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        // Normal users notifying others or themselves cannot spoof admin identity or issue policy warnings
        (
          request.resource.data.get('fromAdmin', false) == false &&
          request.resource.data.get('type', '') != 'warning' &&
          request.resource.data.get('type', '') != 'admin_broadcast' &&
          request.resource.data.get('senderName', '') != 'SellerFlow' &&
          request.resource.data.get('senderName', '') != 'SellerFlow Safety AI' &&
          request.resource.data.get('senderName', '') != 'SellerFlow Security Team' &&
          request.resource.data.get('senderName', '') != 'Admin'
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (resource.data.recipientId == request.auth.uid || resource.data.userId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.userId == request.auth.uid)
      );
    }

    // 9. Community Scam & Safety Reports
    // Regular users can report content/users; only admins can review or resolve reports
    match /scamReports/{reportId} {
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.get('reporterId', request.auth.uid) == request.auth.uid
      );
      allow read, update, delete: if isAdmin();
    }

    // 9a. Anti-Fraud & Security Reports
    // Authenticated users can log fraud reports; only admins can investigate or resolve
    match /fraudReports/{reportId} {
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.get('reporterUid', request.auth.uid) == request.auth.uid ||
        request.resource.data.get('reporterId', request.auth.uid) == request.auth.uid
      );
      allow read, update, delete: if isAdmin();
    }

    // 9b. AI Admin Review Records & Moderation Logs
    // ONLY trusted server processes (via Firebase Admin SDK bypass) and authorized admins can create or manage audit records
    match /adminReviews/{reviewId} {
      allow create, read, update, delete: if isAdmin();
    }

    // 10. Direct Chats & Conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.participants ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Messages subcollection: strictly accessible only by conversation participants
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == resource.data.recipientId ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
        );
        allow create: if isSignedIn() && (
          request.resource.data.senderId == request.auth.uid &&
          (isAdmin() ||
           request.resource.data.get('recipientId', '') != '' ||
           (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants))
        );
        allow update, delete: if isAdmin();
      }
    }

    // 11. Saved Sounds Collection
    match /savedSounds/{userId}/items/{soundId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 12. Audio Sounds Catalog
    match /sounds/{soundId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.get('originatorId', '') == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 13. Profile Visits Analytics
    match /profileVisits/{visitId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.profileId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 14. Platform Settings & Metadata
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 15. Personalized For You Discovery & User Feed Profiles
    // - Users can read and write only their own interest profile
    match /userFeedProfiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 16. Feed Engagement Events (Batched & Debounced Telemetry)
    // - Authenticated users can create telemetry events for their own actions
    // - Read restricted to user themselves and administrators
    match /feedEvents/{eventId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 17. Verified Jobs & Career Listings
    // - Public can view approved jobs
    // - Creators can view their own listings (even when under review/draft/rejected)
    // - Client-side create enforces initial pending_review status (server-only/admin approval)
    // - Normal clients cannot self-assign status: 'approved' or tamper with review badges
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.creatorId == request.auth.uid || isAdmin()
      ) && (
        isAdmin() || (
          request.resource.data.get('status', 'pending_review') in ['pending_review', 'draft'] &&
          request.resource.data.get('reviewStatus', 'pending_review') in ['pending_review', 'draft'] &&
          !('reviewedBy' in request.resource.data) &&
          !('reviewedAt' in request.resource.data)
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.creatorId == request.auth.uid &&
          request.resource.data.creatorId == resource.data.creatorId &&
          request.resource.data.get('status', '') == resource.data.get('status', '') &&
          request.resource.data.get('reviewStatus', '') == resource.data.get('reviewStatus', '') &&
          request.resource.data.get('reviewedBy', '') == resource.data.get('reviewedBy', '')
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'savesCount', 'applicationsCount'])
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
    }

    // 18. Confidential Candidate Job Applications
    // - Strictly private: Accessible ONLY to the applicant and the specific job employer/creator
    // - Ghana Card data and KYC files are NEVER stored in applications
    match /jobApplications/{applicationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.applicantId == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.applicantId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Employer updating application status or adding notes
        (
          resource.data.employerId == request.auth.uid &&
          request.resource.data.applicantId == resource.data.applicantId &&
          request.resource.data.jobId == resource.data.jobId
        ) ||
        // Applicant updating their own submission
        (
          resource.data.applicantId == request.auth.uid &&
          request.resource.data.applicantId == resource.data.applicantId &&
          request.resource.data.jobId == resource.data.jobId
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.applicantId == request.auth.uid || isAdmin()
      );
    }

    // 19. User Job Bookmarks
    match /jobSaves/{userId}/items/{jobId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 20. Verified Events & Gatherings
    // - Public can read approved events
    // - Organizers can manage their own events
    // - Client-side create enforces initial pending_review status
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.creatorId == request.auth.uid || isAdmin()
      ) && (
        isAdmin() || (
          request.resource.data.get('status', 'pending_review') in ['pending_review', 'draft'] &&
          request.resource.data.get('reviewStatus', 'pending_review') in ['pending_review', 'draft'] &&
          !('reviewedBy' in request.resource.data) &&
          !('reviewedAt' in request.resource.data)
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.creatorId == request.auth.uid &&
          request.resource.data.creatorId == resource.data.creatorId &&
          request.resource.data.get('status', '') == resource.data.get('status', '') &&
          request.resource.data.get('reviewStatus', '') == resource.data.get('reviewStatus', '') &&
          request.resource.data.get('reviewedBy', '') == resource.data.get('reviewedBy', '')
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'savesCount', 'registeredCount'])
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
    }

    // 21. Event Registrations & RSVPs
    // - Private to attendee, organizer, and admin
    match /eventRegistrations/{regId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.attendeeId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.attendeeId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.attendeeId == request.auth.uid && request.resource.data.attendeeId == resource.data.attendeeId) ||
        (resource.data.creatorId == request.auth.uid && request.resource.data.creatorId == resource.data.creatorId)
      );
      allow delete: if isSignedIn() && (
        resource.data.attendeeId == request.auth.uid || isAdmin()
      );
    }

    // 22. User Event Bookmarks
    match /eventSaves/{userId}/items/{eventId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 23. Statutory Terms & Privacy Acceptances
    // - Records versioned acceptances of Terms and Privacy notices
    match /termsAcceptances/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 24. Security Review & Moderation Audit Trail
    // - Admin-only immutable log
    match /securityReviews/{reviewId} {
      allow read, write: if isAdmin();
    }
  }
}
