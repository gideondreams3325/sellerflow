rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() in [
          'gideonappiahfriempong@gmail.com',
          'gideondreams99@gmail.com',
          'gideondreams3325@gmail.com',
          'sjssaloon@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    // 1. Private User Profiles & KYC Identity Data
    // - Only the account owner and admins can read private KYC documents (Ghana Card, etc.)
    // - Regular users CANNOT self-assign role: 'admin' or verificationStatus: 'approved'
    // - Only admins can verify or approve sellers
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && (
        isAdmin() || (
          request.resource.data.get('role', 'user') != 'admin' &&
          request.resource.data.get('verified', false) == false &&
          request.resource.data.get('verificationStatus', 'none') in ['none', 'pending']
        )
      );
      allow update: if (isOwner(userId) || isAdmin()) && (
        isAdmin() || (
          // Non-admins cannot promote themselves to admin
          request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
          // Non-admins cannot self-verify
          request.resource.data.get('verified', false) == resource.data.get('verified', false) &&
          // Non-admins cannot approve their own verification
          request.resource.data.get('verificationStatus', 'none') in [resource.data.get('verificationStatus', 'none'), 'pending']
        )
      );
      allow delete: if isAdmin();
    }

    // 2. Public Storefront Profiles & Social Counters
    // - Anyone can view public profiles
    // - Profile owners can edit their own bio, avatar, name, and presence
    // - Non-owners can ONLY update followers array/counter
    // - PublicProfiles CANNOT be used to grant admin status or self-assign verification badges
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if (isOwner(userId) || isAdmin()) && (
        isAdmin() || request.resource.data.get('verified', false) == false
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Profile owner updating their details without tampering with verified badge
        (
          isOwner(userId) &&
          request.resource.data.get('verified', false) == resource.data.get('verified', false)
        ) ||
        // Other users interacting purely via follow/unfollow
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'followersCount'])
        )
      );
      allow delete: if isAdmin();
    }

    // 3. For You Feed Posts & Video Reels
    // - Anyone can view published posts
    // - Normal clients can ONLY create posts in initial hidden/under_review state
    // - Normal clients CANNOT transition posts to published or safe (server-only approval via Admin SDK)
    // - Normal clients CANNOT modify moderation fields or reinstate posts in violation status
    // - Other users can ONLY interact (like, comment, save, view, share, repost)
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.sellerId == request.auth.uid || isAdmin()
      ) && (
        isAdmin() || (
          // Normal users can ONLY create initial post in hidden/under_review state
          request.resource.data.get('status', 'hidden') == 'hidden' &&
          request.resource.data.get('reviewStatus', 'under_review') == 'under_review' &&
          request.resource.data.get('safeContent', false) == false &&
          !('moderatedBy' in request.resource.data) &&
          !('moderationToken' in request.resource.data) &&
          !('violationDetected' in request.resource.data) &&
          !('violationRule' in request.resource.data) &&
          !('violationReason' in request.resource.data) &&
          !('moderatedAt' in request.resource.data) &&
          !('hiddenAt' in request.resource.data)
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Post author normal content edits: cannot self-approve or alter moderation state
        (
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId &&
          // Cannot modify posts in violation status
          resource.data.get('reviewStatus', '') != 'violation' &&
          request.resource.data.get('reviewStatus', '') != 'violation' &&
          // Normal users CANNOT change status to published or reviewStatus to safe
          request.resource.data.get('status', '') == resource.data.get('status', '') &&
          request.resource.data.get('reviewStatus', '') == resource.data.get('reviewStatus', '') &&
          request.resource.data.get('safeContent', false) == resource.data.get('safeContent', false) &&
          // Normal users cannot tamper with moderation flags or authoritatively publish
          request.resource.data.get('moderatedBy', '') == resource.data.get('moderatedBy', '') &&
          request.resource.data.get('moderationToken', '') == resource.data.get('moderationToken', '') &&
          request.resource.data.get('violationDetected', false) == resource.data.get('violationDetected', false) &&
          request.resource.data.get('violationRule', '') == resource.data.get('violationRule', '') &&
          request.resource.data.get('violationReason', '') == resource.data.get('violationReason', '') &&
          request.resource.data.get('moderatedAt', null) == resource.data.get('moderatedAt', null) &&
          request.resource.data.get('hiddenAt', null) == resource.data.get('hiddenAt', null)
        ) ||
        // Community interaction: other users can ONLY modify social interaction counters/arrays
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likes', 'comments', 'saves', 'views', 'shares', 'reposts'
          ]) &&
          request.resource.data.sellerId == resource.data.sellerId
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // 4. Marketplace Products & Catalog
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.sellerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // 5. Vendor Storefronts
    match /stores/{sellerId} {
      allow read: if true;
      allow create, update: if isOwner(sellerId) || isAdmin();
      allow delete: if isOwner(sellerId) || isAdmin();
    }

    // 6. Orders & Checkout Transactions
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        (resource.data.sellerIds is list && request.auth.uid in resource.data.sellerIds) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.buyerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Buyer can cancel or update notes
        (
          resource.data.buyerId == request.auth.uid &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.total == resource.data.total
        ) ||
        // Seller can update order status
        (
          (resource.data.sellerId == request.auth.uid || (resource.data.sellerIds is list && request.auth.uid in resource.data.sellerIds)) &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.total == resource.data.total
        )
      );
      allow delete: if isAdmin();
    }

    // 7. Store Reviews & Verified Ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.reviewerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.reviewerId == request.auth.uid &&
          request.resource.data.reviewerId == resource.data.reviewerId &&
          request.resource.data.sellerId == resource.data.sellerId
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.reviewerId == request.auth.uid || isAdmin()
      );
    }

    // 8. In-App Notifications, Order Alerts & Policy Warnings
    // - Users CANNOT create fake admin broadcasts or fake policy warnings targeting other users
    // - Only admins can issue official admin warnings and broadcasts
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientId == 'all' ||
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'all' ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        // Normal users notifying others or themselves cannot spoof admin identity or issue policy warnings
        (
          request.resource.data.get('fromAdmin', false) == false &&
          request.resource.data.get('type', '') != 'warning' &&
          request.resource.data.get('type', '') != 'admin_broadcast' &&
          request.resource.data.get('senderName', '') != 'SellerFlow' &&
          request.resource.data.get('senderName', '') != 'SellerFlow Safety AI' &&
          request.resource.data.get('senderName', '') != 'Admin'
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (resource.data.recipientId == request.auth.uid || resource.data.userId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.userId == request.auth.uid)
      );
    }

    // 9. Community Scam & Safety Reports
    // Regular users can report content/users; only admins can review or resolve reports
    match /scamReports/{reportId} {
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.get('reporterId', request.auth.uid) == request.auth.uid
      );
      allow read, update, delete: if isAdmin();
    }

    // 9b. AI Admin Review Records & Moderation Logs
    // ONLY trusted server processes (via Firebase Admin SDK bypass) and authorized admins can create or manage audit records
    match /adminReviews/{reviewId} {
      allow create, read, update, delete: if isAdmin();
    }

    // 10. Direct Chats & Conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.participants ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Messages subcollection: strictly accessible only by conversation participants
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == resource.data.recipientId ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
        );
        allow create: if isSignedIn() && (
          request.resource.data.senderId == request.auth.uid &&
          (isAdmin() ||
           request.resource.data.get('recipientId', '') != '' ||
           (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants))
        );
        allow update, delete: if isAdmin();
      }
    }

    // 11. Saved Sounds Collection
    match /savedSounds/{userId}/items/{soundId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 12. Audio Sounds Catalog
    match /sounds/{soundId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.get('originatorId', '') == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 13. Profile Visits Analytics
    match /profileVisits/{visitId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.profileId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 14. Platform Settings & Metadata
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
